# Copy this file to .env and fill in your values. .env is never committed.

# ais.usvisa-info.com login
VISA_EMAIL=you@example.com
VISA_PASSWORD=your_password

# Appointment
COUNTRY_CODE=es-pe
# The number in your reschedule URL: .../niv/schedule/<SCHEDULE_ID>/appointment
SCHEDULE_ID=12345678
# Optional fallback (YYYY-MM-DD). The bot reads your current appointment from the portal;
# this is only used if that fails.
CURRENT_APPOINTMENT_DATE=

# Minutes between checks (randomized x0.8-1.4)
CHECK_INTERVAL_MINUTES=10

# Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=
